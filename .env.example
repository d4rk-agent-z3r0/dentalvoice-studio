# Copy to .env and fill in. Placeholder values only — never commit real secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (docker compose uses the POSTGRES_* values to create the database).
# The password is embedded in the URLs below: use URL-safe characters (letters, digits, - _ . ~),
# e.g. `python3 -c "import secrets; print(secrets.token_hex(16))"`.
POSTGRES_USER=dentalvoice
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=dentalvoice
DATABASE_URL=postgresql+asyncpg://dentalvoice:replace-with-a-local-password@localhost:5432/dentalvoice

# Integration tests point at a separate, disposable database
TEST_DATABASE_URL=postgresql+asyncpg://dentalvoice:replace-with-a-local-password@localhost:5432/dentalvoice_test

# mock = no external calls, no credentials needed. live = real Deepgram + Gemini.
VOICE_PROVIDER_MODE=mock

# Required only when VOICE_PROVIDER_MODE=live (wired in Milestones 4–5)
GEMINI_API_KEY=
GEMINI_MODEL=
DEEPGRAM_API_KEY=
STT_MODEL=
TTS_MODEL=

# Signs API access tokens. Required; 32+ random characters, e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=
# Password for the seeded demo users (demo.admin@example.com, demo.staff@example.com,
# demo.viewer@example.org), applied by `make seed`. 12-128 characters. Choose your own and keep it
# in this local file only. Blank: the demo users cannot sign in with a password (`make dev-token`
# still works outside production).
DEMO_PASSWORD=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
